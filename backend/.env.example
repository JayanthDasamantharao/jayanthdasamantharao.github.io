OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Postgres for chat persistence
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/portfolio_chat

# Admin dashboard protection (required to access /admin/chats and /api/chats/*)
CHAT_ADMIN_ENABLED=false
CHAT_ADMIN_USERNAME=change_me_admin_user
CHAT_ADMIN_PASSWORD=change_me_admin_password
CHAT_ADMIN_SESSION_SECONDS=43200
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
# 0 = index every supported file under Resume/ (including nested Resume/<company>/resume.pdf)
RAG_RESUME_LIMIT=0
RAG_MIN_RELEVANCE_SCORE=0.20

# Resume downloads in chat (sanitized filename for the browser)
RESUME_DOWNLOAD_FILENAME=resume_jayanthd.pdf
RESUME_TOKEN_TTL_SECONDS=900
RAG_MAX_TOKENS=240

# Meeting email workflow
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
JAYANTH_NOTIFY_EMAIL=jayanthdasamantharao@gmail.com
PUBLIC_BASE_URL=http://localhost:8000
# Optional: reuse an existing Google Meet URL in final confirmation
DEFAULT_GMEET_LINK=

# Verify email domain can receive mail (DNS MX) before sending slot / meeting emails
EMAIL_CHECK_DELIVERABILITY=true

# After connect details are collected: email a 6-digit code; Jayanth is notified only after the user pastes it in chat
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFY_TTL_SECONDS=900
EMAIL_VERIFY_MAX_ATTEMPTS=8
# Change in production (used to hash codes on disk)
EMAIL_VERIFY_PEPPER=change_me_long_random_secret
